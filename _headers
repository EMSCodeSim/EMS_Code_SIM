/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.mp3
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=86400

/*.css
  Cache-Control: public, max-age=604800

# Scenario UI changes should be visible immediately after deploy

/vitals/scenario-launcher.html
  Cache-Control: no-cache, no-store, must-revalidate

/vitals/scenario-launcher.js
  Cache-Control: no-cache, no-store, must-revalidate

/vitals/scenario-launcher.css
  Cache-Control: no-cache, no-store, must-revalidate

/vitals/visual-patient.html
  Cache-Control: no-cache, no-store, must-revalidate

/vitals/visual-patient.js
  Cache-Control: no-cache, no-store, must-revalidate

/vitals/visual-patient.css
  Cache-Control: no-cache, no-store, must-revalidate

/vitals/scenario-interviews.js
  Cache-Control: no-cache, no-store, must-revalidate
